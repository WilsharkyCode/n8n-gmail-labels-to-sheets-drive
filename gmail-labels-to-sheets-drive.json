      "id": "55119650-edb4-479d-8abd-7a465f041fa8",
      "name": "Get Gmail Labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        256,
        368
      ],
      "executeOnce": true,
      "webhookId": "6ea20770-f446-43c7-a387-f3f60794b33e",
      "credentials": {
        "gmailOAuth2": {
          "id": "13NXB0x7Jy6B6bQf",
          "name": "Gmail account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ===== CONFIG (edit these) =====\nconst TARGET_LABELS = ['label1', 'label2', 'label3'];   // keep in sync with the Gmail Trigger search\nconst ROOT_FOLDER_ID = '1_V2kI9mKaVevIiXEa0gZXYMwMYn_wrWX';     // Drive folder that will hold everything\nconst TZ = 'Asia/Manila';                               // timezone used for the date folders\n// ================================\n\nconst targets = TARGET_LABELS.map(l => l.toLowerCase());\n\nconst labelMap = {};\nfor (const l of $('Get Gmail Labels').all()) labelMap[l.json.id] = l.json.name;\n\nconst safeName = s => (s || '').replace(/[\\\\/]/g, '-').replace(/\\s+/g, ' ').trim();\nconst esc = s => s.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");   // for Drive query strings\n\nfunction parseSender(j) {\n  if (j.from && j.from.value && j.from.value.length) {\n    return { name: j.from.value[0].name || '', email: j.from.value[0].address || '' };\n  }\n  const raw = j.From || (j.from && j.from.text) || (typeof j.from === 'string' ? j.from : '') || '';\n  const m = raw.match(/^\\s*\"?([^\"<]*?)\"?\\s*<([^>]+)>\\s*$/);\n  return m ? { name: m[1].trim(), email: m[2].trim() } : { name: '', email: raw.trim() };\n}\n\nconst out = [];\nfor (const item of $('Gmail Trigger').all()) {\n  const j = item.json;\n  const sender = parseSender(j);\n  const ts = j.internalDate ? new Date(Number(j.internalDate)) : new Date(j.date);\n  const dateFolder = ts.toLocaleDateString('en-CA', { timeZone: TZ });      // YYYY-MM-DD\n  const receivedAt = ts.toLocaleString('sv-SE', { timeZone: TZ });          // YYYY-MM-DD HH:mm:ss\n\n  const binKeys = Object.keys(item.binary || {});\n  const attachmentNames = binKeys.map(k => item.binary[k].fileName || k);\n  const senderFolder = safeName(sender.name) || sender.email || 'Unknown sender';\n\n  const matched = (j.labelIds || [])\n    .map(id => labelMap[id])\n    .filter(n => n && targets.includes(n.toLowerCase()));\n\n  for (const label of matched) {\n    const labelFolder = safeName(label);\n    out.push({\n      json: {\n        messageId: j.id,\n        label,\n        senderName: sender.name,\n        senderEmail: sender.email,\n        subject: j.subject || j.Subject || '',\n        receivedAt,\n        attachmentCount: binKeys.length,\n        attachmentNames: attachmentNames.join(', '),\n        drivePath: binKeys.length ? `${labelFolder}/${dateFolder}/${senderFolder}` : '',\n        rootFolderId: ROOT_FOLDER_ID,\n        labelFolder, dateFolder, senderFolder,\n        labelFolderQ: esc(labelFolder),\n        dateFolderQ: esc(dateFolder),\n        senderFolderQ: esc(senderFolder)\n      },\n      binary: item.binary\n    });\n  }\n}\nreturn out;"
      },
