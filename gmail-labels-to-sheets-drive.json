    {
      "parameters": {
        "jsCode": "// Re-attach the email's binaries (Drive nodes drop them) and emit one item per attachment\nconst email = $('Loop Over Items').first();\nconst folderId = $input.first().json.folderId;\n\nconst out = [];\nfor (const key of Object.keys(email.binary || {})) {\n  const bin = email.binary[key];\n  out.push({\n    json: {\n      fileName: bin.fileName || `${key}.${bin.fileExtension || 'bin'}`,   // original filename\n      folderId,\n      label: email.json.label,\n      sender: email.json.senderFolder,\n      date: email.json.dateFolder,\n      messageId: email.json.messageId\n    },\n    binary: { data: bin }\n  });\n}\nreturn out;"
      },
